            "value": "// Thresholds: keep in sync with the Route by Category condition and Build Log Row\nconst scope = <jevclassifier.answers.shoe_scope>;\nif (scope && scope.choice === \"unrelated\" && Number(scope.confidence ?? 1) >= 0.6) {\n  return \"Thank you for reaching out! We sell only men's and women's sport shoes, so we can only help with questions about our shoes. If your message is about a pair of our shoes or a shoe order, please tell us which shoes it's about and we'll be glad to help.\";\n}\nreturn \"Thank you for reaching out. A member of our customer service team will be in contact with you shortly.\";"
