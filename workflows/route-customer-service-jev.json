            "value": "[{\"title\":\"If\",\"value\":\"<jevclassifier.answers.shoe_scope.choice> === 'unrelated' && Number(<jevclassifier.answers.shoe_scope.confidence> ?? 1) >= 0.6\",\"id\":\"10cb24c3-a0d3-4ab4-b8df-982aa8ffb603-if\"},{\"title\":\"Else If\",\"value\":\"<jevclassifier.answers.shoe_scope.choice> === 'related_needs_details' || Number(<jevclassifier.answers.shoe_scope.confidence> ?? 1) < 0.6\",\"id\":\"10cb24c3-a0d3-4ab4-b8df-982aa8ffb603-else-if-0\"},{\"title\":\"Else If\",\"value\":\"Number(<jevclassifier.answers.category.confidence> ?? 0) < 0.6\",\"id\":\"10cb24c3-a0d3-4ab4-b8df-982aa8ffb603-else-if-1\"},{\"title\":\"Else If\",\"value\":\"<jevclassifier.answers.category.choice> === 'billing'\",\"id\":\"10cb24c3-a0d3-4ab4-b8df-982aa8ffb603-else-if-2\"},{\"title\":\"Else If\",\"value\":\"<jevclassifier.answers.category.choice> === 'support'\",\"id\":\"10cb24c3-a0d3-4ab4-b8df-982aa8ffb603-else-if-3\"},{\"title\":\"Else If\",\"value\":\"<jevclassifier.answers.category.choice> === 'sales'\",\"id\":\"10cb24c3-a0d3-4ab4-b8df-982aa8ffb603-else-if-4\"},{\"title\":\"Else If\",\"value\":\"<jevclassifier.answers.category.choice> === 'return'\",\"id\":\"10cb24c3-a0d3-4ab4-b8df-982aa8ffb603-else-if-5\"},{\"title\":\"Else If\",\"value\":\"<jevclassifier.answers.category.choice> === 'shipping'\",\"id\":\"10cb24c3-a0d3-4ab4-b8df-982aa8ffb603-else-if-6\"},{\"title\":\"Else\",\"value\":\"\",\"id\":\"10cb24c3-a0d3-4ab4-b8df-982aa8ffb603-else\"}]"
