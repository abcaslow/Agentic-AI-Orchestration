      "d6985b97-a10b-4ebc-b430-11f1c66347f4": {
        "id": "d6985b97-a10b-4ebc-b430-11f1c66347f4",
        "type": "function",
        "name": "Build Log Row",
        "position": {
          "x": 1710,
          "y": 390
        },
        "subBlocks": {
          "code": {
            "id": "code",
            "type": "code",
            "value": "const SENTIMENT_LABELS = { calm: \"Calm\", irritated_frustrated: \"Irritated/Frustrated\", very_angry: \"Very Angry\" };\nconst jev = <jevclassifier.answers.category>;\nconst scope = <jevclassifier.answers.shoe_scope>;\nconst jevSentiment = <jevclassifier.answers.sentiment>;\nconst followUp = <followupreply.result>;\nconst category =\n  <billingreply.result> != null ? \"Billing\" :\n  <techsupportreply.result> != null ? \"Technical Support\" :\n  <salesreply.result> != null ? \"Sales\" :\n  <returnreply.result> != null ? \"Product Return\" :\n  <shippingreply.result> != null ? \"Shipping\" :\n  (followUp != null && jev && jev.choice === \"sales\") ? \"Sales\" : \"Other\";\nconst fmt = v => (v != null ? Number(v).toFixed(2) : \"n/a\");\nlet categoryReason = \"\";\nif (jev && jev.choice) {\n  const p = jev.probabilities || {};\n  categoryReason = `${jev.choice} (confidence ${fmt(jev.confidence)}; billing ${fmt(p.billing)}, support ${fmt(p.support)}, sales ${fmt(p.sales)}, return ${fmt(p.return)}, shipping ${fmt(p.shipping)}, other ${fmt(p.other)})`;\n} else if (<jevclassifier.error>) {\n  categoryReason = `Jev failed, defaulted to Other: ${<jevclassifier.error>}`;\n}\nlet sentiment = null;\nlet sentimentReason = \"\";\nif (jevSentiment && jevSentiment.choice) {\n  sentiment = SENTIMENT_LABELS[jevSentiment.choice] ?? null;\n  const p = jevSentiment.probabilities || {};\n  sentimentReason = `${jevSentiment.choice} (confidence ${fmt(jevSentiment.confidence)}; calm ${fmt(p.calm)}, irritated ${fmt(p.irritated_frustrated)}, very angry ${fmt(p.very_angry)})`;\n}\nlet shoeScopeReason = \"\";\nif (scope && scope.choice) {\n  const p = scope.probabilities || {};\n  shoeScopeReason = `${scope.choice} (confidence ${fmt(scope.confidence)}; unrelated ${fmt(p.unrelated)}, related needs details ${fmt(p.related_needs_details)}, related clear ${fmt(p.related_clear)})`;\n}\nreturn {\n  message: <start.input> ?? \"\",\n  category,\n  category_reason: categoryReason,\n  conversation_id: <start.conversationId> ?? \"\",\n  source: \"Jev\",\n  sentiment_reason: sentimentReason,\n  sentiment,\n  shoe_scope_reason: shoeScopeReason\n};"
          },
          "language": {
            "id": "language",
            "type": "dropdown",
            "value": "javascript"
          },
