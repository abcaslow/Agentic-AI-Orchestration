{
  "identifier": "findrestaurant",
  "url": "https://www.sim.ai/chat/findrestaurant",
  "title": "find a restaurant",
  "description": "",
  "isActive": true,
  "authType": "public",
  "allowedEmails": [],
  "customizations": {
    "primaryColor": "var(--brand-hover)",
    "welcomeMessage": "Hi there! How can I help you today?"
  },
  "outputConfigs": [
    {
      "blockId": "6685888a-b800-40fc-bdb8-65b57426d8b9",
      "path": "result"
    },
    {
      "blockId": "8f0de8d2-b5c4-435c-86a9-1df7e006ff6a",
      "path": "result"
    },
    {
      "blockId": "c4a3aab8-d570-4dfc-bce2-2f25fe935103",
      "path": "result"
    }
  ],
  "includeThinking": false,
  "includeToolCalls": false,
  "displayedMessages": [
    {
      "order": 1,
      "block": "pleaseWait",
      "blockId": "6685888a-b800-40fc-bdb8-65b57426d8b9",
      "path": "result",
      "shows": "Searching message with the user's prompt and the 5-second wait estimate"
    },
    {
      "order": 2,
      "block": "totalTime",
      "blockId": "8f0de8d2-b5c4-435c-86a9-1df7e006ff6a",
      "path": "result",
      "shows": "The final answer (restaurant list, saved results, nothing found, or an off-topic notice for non-restaurant requests) followed by the total time to execute"
    },
    {
      "order": 3,
      "block": "blockInventory",
      "blockId": "c4a3aab8-d570-4dfc-bce2-2f25fe935103",
      "path": "result",
      "shows": "Agent blocks using Jev (with the question types each uses: choice, score, noul), Exa blocks, and Agent blocks not using Jev (with models and fallback), each with the time it took in this run or 'did not run'"
    }
  ],
  "workflowInventory": {
    "agentBlocksUsingJev": {
      "count": 6,
      "model": "jev-latest",
      "blocks": [
        {
          "name": "jevRouteScorer",
          "questionTypes": [
            "noul"
          ],
          "questionSource": "static in block (instant_likely, is_restaurant_search)"
        },
        {
          "name": "jevInstantGuard",
          "questionTypes": [
            "noul"
          ],
          "questionSource": "screenInstant.result.guardQuestions"
        },
        {
          "name": "jevQueryOptimizer",
          "questionTypes": [
            "noul"
          ],
          "questionSource": "buildJevCandidates.result.questions"
        },
        {
          "name": "jevResultGuard",
          "questionTypes": [
            "noul"
          ],
          "questionSource": "normalizeResults.result.guardQuestions"
        },
        {
          "name": "jevFinalCheck",
          "questionTypes": [
            "noul"
          ],
          "questionSource": "buildFinalCheck.result.questions"
        },
        {
          "name": "jevCacheMatch",
          "questionTypes": [
            "choice"
          ],
          "questionSource": "cacheCandidates.result.questions"
        }
      ],
      "questionTypesNotUsed": [
        "score"
      ]
    },
    "exaBlocks": {
      "count": 2,
      "blocks": [
        "exaInstant",
        "webSearch"
      ]
    },
    "agentBlocksNotUsingJev": {
      "count": 2,
      "blocks": [
        {
          "name": "parseRequest",
          "model": "claude-haiku-5-5",
          "thinkingLevel": "none",
          "fallbackModels": [
            "gemini-3.5-flash-lite"
          ]
        },
        {
          "name": "restaurantFinder",
          "model": "claude-haiku-5-5",
          "thinkingLevel": "none",
          "fallbackModels": [
            "gemini-3.5-flash-lite"
          ]
        }
      ]
    }
  },
  "blockTiming": {
    "jevAgents": "Model call time each Agent reports (providerTiming.duration); within ~10 ms of the logged block time",
    "exaInstant": "~ time between routeDecision.result.t and screenInstant.result.t",
    "webSearch": "~ time between buildSearchPayload.result.t and normalizeResults.result.t",
    "parseRequest": "~ time between clockStart.result.t and markStart.result.t",
    "restaurantFinder": "~ time between selectResults.result.t and buildFinalCheck.result.t",
    "notTimed": "Function, Condition and Table blocks (typically 30-130 ms each)"
  },
  "providerKeys": {
    "note": "Workspace BYOK provider keys (Settings > BYOK); no keys are stored in the workflow. Sim charges only the per-run execution fee.",
    "providers": {
      "anthropic": "parseRequest, restaurantFinder (claude-haiku-5-5, primary)",
      "exa": "exaInstant, webSearch",
      "google": "parseRequest, restaurantFinder (gemini-3.5-flash-lite, fallback only)",
      "typesafe": "Jev agents (jev-latest)"
    }
  }
}
